<!-- Week 2 reference geometry. The browser explorer sets joint angles directly.
     Both joints rotate about world z, with q2 relative to the first link.
     Compare site positions with analytic FK using mj_forward, without stepping. -->
<mujoco model="planar_two_link">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.1"/>
    <geom type="capsule" size="0.035" density="500"
          contype="0" conaffinity="0"/>
  </default>
  <worldbody>
    <body name="shoulder" pos="0 0 0.2">
      <joint name="shoulder_joint"/>
      <site name="base" pos="0 0 0" size="0.045"/>
      <geom name="link1" fromto="0 0 0 1 0 0" rgba="0.15 0.4 0.85 1"/>
      <body name="elbow" pos="1 0 0">
        <joint name="elbow_joint"/>
        <site name="elbow_site" pos="0 0 0" size="0.045"/>
        <geom name="link2" fromto="0 0 0 0.75 0 0" rgba="0.9 0.4 0.1 1"/>
        <site name="hand" pos="0.75 0 0" size="0.05"/>
      </body>
    </body>
  </worldbody>
</mujoco>
